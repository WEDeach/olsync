{
  "name": "olsync",
  "version": "1.1.0",
  "main": "./dist/main.js",
  "scripts": {
    "build": "concurrently \"npm run dev:electron\" \"npm run dev:react\"",
    "dev": "concurrently \"npm run dev:react\" \"npm run electron:serve\" \"npm run dev:electron\"",
    "dev:electron": "cross-env NODE_ENV=development webpack --config webpack/electron.webpack.ts --mode=development",
    "dev:electron-preload": "cross-env NODE_ENV=development webpack --config webpack/electron.preload.webpack.ts --mode=development",
    "dev:react": "cross-env NODE_ENV=development webpack serve --config webpack/react.webpack.ts --mode=development",
    "electron:serve": "wait-on http-get://localhost:18519/ && npm run dev:electron-preload && npm run start:electron",
    "start:electron": "electron .",
    "build:prod": "concurrently \"npm run build:electron\" \"npm run build:react\"",
    "build:electron": "cross-env NODE_ENV=production webpack --config webpack/electron.webpack.ts --mode=production",
    "build:electron-preload": "cross-env NODE_ENV=production webpack --config webpack/electron.preload.webpack.ts --mode=production",
    "build:react": "cross-env NODE_ENV=production webpack --config webpack/react.webpack.ts --mode=production",
    "generate:manifest": "tsx scripts/generate-release.ts",
    "generate:release": "tsx scripts/generate-release.ts",
    "publish:release": "tsx scripts/publish-release.ts",
    "build:bin": "tsx scripts/build-stable-ipc.ts",
    "pack": "npm run build:prod && npm run build:electron-preload && npm run build:bin && electron-builder --dir",
    "dist": "npm run build:prod && npm run build:electron-preload && npm run build:bin && electron-builder",
    "predist:win": "npm run build:prod && npm run build:electron-preload && npm run build:bin",
    "dist:win": "electron-builder --win && npx tsx scripts/generate-release.ts ./release/win-unpacked %npm_package_version%",
    "predist:win:signed": "npm run build:prod && npm run build:electron-preload && npm run build:bin",
    "dist:win:signed": "electron-builder --win && npx tsx scripts/generate-release.ts ./release/win-unpacked %npm_package_version% --sign-key ./keys/private.pem",
    "gen-keys": "npx tsx scripts/generate-release.ts --gen-keys ./keys",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "optimize-png": "npx ts-node scripts/optimize-png.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "author": "WEDeach",
  "license": "GPL-3.0-or-later",
  "description": "osu! sync tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/WEDeach/olsync.git"
  },
  "build": {
    "appId": "com.wedeach.olsync",
    "productName": "olSync",
    "asar": true,
    "npmRebuild": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "i18n",
        "to": "i18n",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin/win",
        "to": "bin/win",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "realm": "^12.14.2",
    "rosu-pp-js": "^4.0.1",
    "unbzip2-stream": "^1.4.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@biomejs/biome": "^2.4.4",
    "@electron/rebuild": "^4.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react-dom": "^19.1.2",
    "@types/react-virtualized": "^9.22.2",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/yauzl": "^3.4.0",
    "@zenoaihq/tson": "^1.0.2",
    "binary-parser": "^2.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.19",
    "electron": "^35.2.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.6.3",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "oxipng-bin": "^1.0.0",
    "pngquant-bin": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-virtualized": "^9.22.6",
    "remark-gfm": "^4.0.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.6",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "webpack-node-externals": "^3.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^11.0.0"
  }
}
