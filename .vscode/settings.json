{
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "explicit"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "git.ignoreLimitWarning": true,
    "files.exclude": {
        ".build-snapshots/**": true,
        "node_modules": true,
        "release": true
    },
    "search.exclude": {
        "dist": true
    }
}